<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Visibility="Collapsed">
 <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <TextBlock Text="As regras têm prioridade sobre o perfil geral da janela. Selecione uma regra para editar, ou crie uma nova." Foreground="#9AAAC0" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <ListBox x:Name="RuleList" Height="110" Background="#182232" BorderBrush="#34445D" Margin="0,0,0,18"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0"><TextBlock Text="Quando aplicar" Margin="0,0,0,7"/><ComboBox x:Name="RuleScope"/><TextBlock Text="Identificar pela" Margin="0,14,0,7"/><ComboBox x:Name="RuleKind"/><TextBlock Text="Aplicativo, classe ou trecho do título" Margin="0,14,0,7"/><TextBox x:Name="RuleMatch" ToolTip="Para processos, use somente o nome: Code.exe, chrome.exe etc."/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="Efeito" Margin="0,0,0,7"/><ComboBox x:Name="RuleEffect"/><TextBlock Text="Cor #RRGGBBAA" Margin="0,14,0,7"/><TextBox x:Name="RuleColor" MaxLength="9"/><TextBlock Text="Raio de desfoque (0 a 750)" Margin="0,14,0,7"/><TextBox x:Name="RuleRadius"/></StackPanel>
   </Grid>
   <StackPanel Orientation="Horizontal"><CheckBox x:Name="RuleLine" Content="Mostrar linha" Margin="0,14,24,8"/><CheckBox x:Name="RulePeek" Content="Mostrar botão do desktop" Margin="0,14,0,8"/></StackPanel>
   <Border Background="#182232" CornerRadius="8" Padding="14" Margin="0,8,0,0"><StackPanel><TextBlock Text="Quando o aplicativo perder o foco" Foreground="#A9BBD0" Margin="0,0,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Name="InactiveEffect" Margin="0,0,16,0"/><TextBox x:Name="InactiveColor" Grid.Column="1" MaxLength="9"/></Grid><TextBlock Text="A aparência inativa é usada para a janela maximizada. No perfil visível, a regra só considera a janela em primeiro plano." TextWrapping="Wrap" FontSize="11" Foreground="#71859E" Margin="0,8,0,0"/></StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
 <StackPanel Grid.Row="1"><TextBlock x:Name="RuleMessage" TextWrapping="Wrap" Foreground="#79E0CE" Margin="0,10,0,10"/><StackPanel Orientation="Horizontal"><Button x:Name="SaveRuleButton" Content="Salvar regra" Background="#72E4D2" Foreground="#102A2D"/><Button x:Name="NewRuleButton" Content="Nova regra"/><Button x:Name="RemoveRuleButton" Content="Remover selecionada"/></StackPanel></StackPanel>
</Grid>
