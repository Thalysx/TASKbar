<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TaskBAR · Sua barra, seu estilo" Width="1080" Height="780" MinWidth="920" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#10151E" Foreground="#E7EDF5" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#9AAAC0"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#253249"/><Setter Property="Foreground" Value="#EEF4FF"/><Setter Property="Padding" Value="18,11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,10,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101722"/><Setter Property="Foreground" Value="#E7EDF5"/><Setter Property="BorderBrush" Value="#34445D"/><Setter Property="Padding" Value="12,9"/><Setter Property="CaretBrush" Value="#5FE0CE"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D9E3F0"/><Setter Property="Margin" Value="0,10,0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Foreground" Value="#101722"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="15,13"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Foreground" Value="#B1BED0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Frame" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="#263A47"/><Setter Property="Foreground" Value="#7BE9DA"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#223045"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="#10151E">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#161E2B" BorderBrush="#253249" BorderThickness="0,0,1,0">
   <DockPanel Margin="20,28,20,22">
    <StackPanel DockPanel.Dock="Top" Margin="12,0,0,32"><TextBlock Text="TASKBAR" FontSize="27" FontWeight="Bold" Foreground="#73E4D1"/><TextBlock Text="Sua barra, seu estilo." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="WINDOWS · v0.3" FontSize="11" Foreground="#70839E" Margin="12,0,0,14"/><Button x:Name="AboutButton" Content="Sobre o TaskBAR" Margin="0"/></StackPanel>
    <StackPanel><TextBlock Text="PERFIS DE APARÊNCIA" FontSize="10" FontWeight="Bold" Foreground="#71859E" Margin="12,0,0,14"/><ListBox x:Name="Profiles" Background="Transparent" BorderThickness="0"/><Button x:Name="JsonButton" Content="Regras e JSON" Margin="0,18,0,0"/><Button x:Name="ImportButton" Content="Importar configuração" Margin="0,12,0,0"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="32,28,32,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock x:Name="PageTitle" Text="Área de trabalho" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Text="Defina a aparência quando o desktop estiver livre." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><Button x:Name="ActivateButton" Content="Ativar TaskBAR" Background="#72E4D2" Foreground="#102A2D" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0"/></Grid>
   <Border x:Name="ConflictPanel" Grid.Row="1" Background="#3D3020" BorderBrush="#765A29" BorderThickness="1" CornerRadius="7" Padding="15,12" Margin="0,20,0,0" Visibility="Collapsed"><TextBlock Text="O TranslucentTB está aberto. Encerre-o pelo ícone da bandeja antes de ativar o TaskBAR." Foreground="#F0D39C" TextWrapping="Wrap"/></Border>
   <Grid x:Name="PageArea" Grid.Row="2" Margin="0,22,0,0">
    <Grid x:Name="EditorPage"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <Border Background="#1B2637" CornerRadius="10" Padding="20" Margin="0,0,0,22"><StackPanel><TextBlock Text="PRÉVIA DO PERFIL" FontSize="10" Foreground="#90A4BC" Margin="0,0,0,14"/><Grid Height="90" ClipToBounds="True"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#375D76" Offset="0"/><GradientStop Color="#426C68" Offset="0.45"/><GradientStop Color="#5E416F" Offset="1"/></LinearGradientBrush></Grid.Background><Ellipse Width="190" Height="190" Fill="#66A6B7A0" HorizontalAlignment="Left" Margin="-40,-120,0,0"/><Border x:Name="PreviewBar" Height="43" VerticalAlignment="Bottom" BorderBrush="#B5CED4" BorderThickness="0,0,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="⊞" FontSize="25" Margin="0,0,18,0"/><TextBlock Text="⌕" FontSize="24" Margin="0,0,18,0"/><Border Width="18" Height="18" Background="#73A9E8" CornerRadius="4" Margin="0,0,18,0"/><Border Width="18" Height="18" Background="#EBC968" CornerRadius="3" Margin="0,0,18,0"/><Border Width="18" Height="18" Background="#AA92E7" CornerRadius="4"/></StackPanel></Border></Grid><TextBlock x:Name="PreviewCaption" Text="Transparência total · sem linha" Foreground="#A9BBD0" FontSize="12" Margin="0,12,0,0"/><TextBlock Text="Ilustração do perfil. O efeito real é aplicado ao ativar." Foreground="#71859E" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Efeito" FontWeight="SemiBold" Margin="0,0,0,9"/><ComboBox x:Name="Effect"/><TextBlock Text="Cor e transparência" FontWeight="SemiBold" Margin="0,22,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="HexColor" MaxLength="9"/><Button x:Name="ColorButton" Content="Cor" Grid.Column="1" Margin="8,0,0,0" Padding="14,8"/></Grid><TextBlock Text="#RRGGBBAA · os dois últimos dígitos são a opacidade" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><CheckBox x:Name="Enabled" Content="Usar este perfil"/><CheckBox x:Name="ShowLine" Content="Mostrar linha da barra"/><CheckBox x:Name="ShowPeek" Content="Mostrar botão do desktop" ToolTip="Disponível quando o Windows expõe o botão clássico. Ocultá-lo preserva o clique."/><TextBlock Text="Raio de desfoque" FontWeight="SemiBold" Margin="0,15,0,9"/><TextBox x:Name="BlurRadius"/><TextBlock Text="De 0 a 750 · utilizado no efeito Desfoque" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel></Grid>
     </StackPanel>
    </ScrollViewer><StackPanel Grid.Row="1"><TextBlock x:Name="EditMessage" Foreground="#79E0CE" TextWrapping="Wrap" Margin="0,8,0,0"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="SaveButton" Content="Salvar perfil" Background="#72E4D2" Foreground="#102A2D"/><Button x:Name="TransparentButton" Content="Tudo transparente"/></StackPanel></StackPanel></Grid>
    <Grid x:Name="JsonPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Edite os perfis, regras por aplicativo e janelas ignoradas. As alterações só entram em vigor após validar." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/><TextBox x:Name="JsonEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="14"/><StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="JsonMessage" TextWrapping="Wrap" Foreground="#79E0CE" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><Button x:Name="ApplyJsonButton" Content="Validar e salvar" Background="#72E4D2" Foreground="#102A2D"/><Button x:Name="ExportButton" Content="Exportar JSON"/></StackPanel></StackPanel></Grid>
    <StackPanel x:Name="AboutPage" Visibility="Collapsed"><TextBlock Text="Uma barra que acompanha você." FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Perfis por estado, regras por aplicativo e transparência em cada monitor. Seu arquivo fica na pasta data do TaskBAR." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,18,0,20"/><TextBlock Text="Use o ícone na bandeja para acessar os perfis. Para restaurar a barra e encerrar o aplicativo, escolha Sair no menu desse ícone." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,20"/><TextBlock Text="Pesquisa e Visão de tarefas podem variar entre versões do Windows. Os estados observados aparecem no painel abaixo." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><TextBlock Text="TaskBAR 0.3 · GPL-3.0&#x0a;Inclui ExplorerTAP do projeto TranslucentTB.&#x0a;Código-fonte e créditos acompanham o aplicativo." TextWrapping="Wrap" Foreground="#71859E" Margin="0,28,0,0"/></StackPanel>
   </Grid>
   <Border Grid.Row="3" Background="#182232" CornerRadius="8" Padding="16,12" Margin="0,18,0,0"><StackPanel><TextBlock Text="ESTADOS OBSERVADOS" Foreground="#748AA5" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="MonitorStatus" Text="Detectando monitores…" Foreground="#BECBE0" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  </Grid>
  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#0D121A" BorderBrush="#253249" BorderThickness="0,1,0,0" Padding="24,10"><Grid><TextBlock x:Name="Status" Text="Pausado · pronto para configurar" Foreground="#9DB1CA" VerticalAlignment="Center" Margin="0,0,280,0" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="RestoreButton" Content="Restaurar Windows" Padding="12,6"/><Button x:Name="TrayButton" Content="Ir para bandeja" Padding="12,6" Margin="0"/></StackPanel></Grid></Border>
 </Grid>
</Window>
